{
  "name": "@qe/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../../.env src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx --env-file=../../../.env src/database.ts migrate",
    "db:seed": "tsx --env-file=../../../.env src/database.ts seed",
    "db:seed:more": "tsx --env-file=../../../.env src/database.ts seed-more"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/pg": "^8.15.0",
    "@types/node": "^22.18.0",
    "tsx": "^4.20.0",
    "vitest": "^3.2.0"
  }
}
